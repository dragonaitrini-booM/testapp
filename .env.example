# Environment Variables Template
# Copy this to .env and add your actual values

# Hugging Face API Token (for Batch mode)
# Get your token at: https://huggingface.co/settings/tokens
VITE_HF_TOKEN=hf_your_token_here

# Kimi K2 Instructor Model (or alternative)
VITE_HF_MODEL=microsoft/DialoGPT-medium

# Note: The application works without tokens in Interactive mode (simulation)
